# Ships as ArcAuras: the folder name picks the toc and the SavedVariables file.
package-as: ArcAuras

# The ArcUI stand-in ships beside it, so installing Arc Auras always loads the
# old Arc UI Forever save (ArcUI.lua) for the move, and replaces the old addon.
move-folders:
  ArcAuras/Bridge/ArcUI: ArcUI

manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - .git
  - .github
  - .gitignore
  - .gitattributes
  - .claude
  - .pkgmeta
  - CHANGELOG.md
  - CHANGELOG-retail.md
  - README.md
  - ArcDisplay.toc
  - "*.bak"
  - Textures/ArcUI_Icon_400x400.tga
  - Textures/ArcUI_Icon_Dial_256.tga
  - Textures/ArcUI_Minimap_64.tga
  - Core/AD_ImportArcUI.lua
  - Core/AD_ImportArcUIRead.lua
  - Core/AD_ImportArcUIIcon.lua
  - UI/AD_ImportArcUIOptions.lua
  - Textures/ArcUI_Icon_128.tga
  - Libs/LibCustomGlow-1.0/README.md
  - Libs/LibCustomGlow-1.0/cspell.json
  - Libs/LibCustomGlow-1.0/LibCustomGlow-1.0_old.xml
  - Libs/LibDeflate/docs
  - Libs/LibDeflate/examples
  - Libs/LibDeflate/LibStub
  - Libs/LibDeflate/README.md
  - Libs/LibDeflate/changelog.md
  - Libs/LibDeflate/libdeflate-1.0.2-1.rockspec
