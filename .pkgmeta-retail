# The retail build (release.yml's retail step: -g retail -m .pkgmeta-retail).
# Ships the ArcAuras folder alone: retail players have the real ArcUI, so the
# Forever stand-in (Bridge) stays out of this zip.
package-as: ArcAuras

manual-changelog:
  filename: CHANGELOG-retail.md
  markup-type: markdown

ignore:
  - .git
  - .github
  - .gitignore
  - .gitattributes
  - .claude
  - .pkgmeta
  - CHANGELOG.md
  - CHANGELOG-retail.md
  - README.md
  - ArcDisplay.toc
  - Bridge
  - "*.bak"
  - Textures/ArcUI_Icon_400x400.tga
  - Textures/ArcUI_Icon_Dial_256.tga
  - Textures/ArcUI_Minimap_64.tga
  - Libs/LibCustomGlow-1.0/README.md
  - Libs/LibCustomGlow-1.0/cspell.json
  - Libs/LibCustomGlow-1.0/LibCustomGlow-1.0_old.xml
  - Libs/LibDeflate/docs
  - Libs/LibDeflate/examples
  - Libs/LibDeflate/LibStub
  - Libs/LibDeflate/README.md
  - Libs/LibDeflate/changelog.md
  - Libs/LibDeflate/libdeflate-1.0.2-1.rockspec
